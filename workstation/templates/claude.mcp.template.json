{
  "mcpServers": {
    "konnect": {
      "type": "stdio",
      "command": "${KONNECT_CUSTOM_EXE}",
      "args": [
        "--config",
        "${KONNECT_SETTINGS_JSON}"
      ],
      "env": {}
    },
    "kicad": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${KICAD_MCP_INDEX}"
      ],
      "env": {}
    }
  }
}
